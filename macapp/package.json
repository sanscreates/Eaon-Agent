{
  "name": "eaon-desktop",
  "productName": "Eaon Agent",
  "version": "1.5.0",
  "description": "macOS desktop shell for the Eaon Agent terminal AI coding agent (spawns the agent inside a real PTY).",
  "private": true,
  "main": "main.js",
  "type": "commonjs",
  "author": "Eaon",
  "license": "GPL-3.0-only",
  "scripts": {
    "start": "electron .",
    "package-engine": "node scripts/package-engine.mjs",
    "predist": "node scripts/package-engine.mjs",
    "dist": "electron-builder --mac",
    "smoke": "node e2e/smoke.mjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "xterm": "^5.3.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.eaon.agent",
    "productName": "Eaon Agent",
    "artifactName": "Eaon-Agent-${version}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "resources/engine",
        "to": "engine",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": true,
    "npmRebuild": false,
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg"
      ],
      "icon": "build/icon.icns",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "Eaon ${version}"
    }
  }
}